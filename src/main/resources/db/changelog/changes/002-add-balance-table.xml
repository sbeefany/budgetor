<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="002-create-balance-table" author="budgetor">
        <createTable tableName="user_balance">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(19, 2)" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Initialize the single row for the MVP user -->
        <insert tableName="user_balance">
            <column name="id" valueNumeric="1"/>
            <column name="amount" valueNumeric="0.00"/>
        </insert>
    </changeSet>

</databaseChangeLog>
